{
  "name": "default",

  "window": {
    "size": [340, 250],
    "transparent": "#010203",
    "alpha": 1.0,
    "topmost": true
  },

  "face": {
    "font": ["Consolas", 20],
    "color": "#f2e6a8",
    "x": 0.5,
    "y": 0.70,
    "spacing": 1,
    "shadow": "#050508"
  },

  "bubble": {
    "font": ["Segoe UI", 10],
    "color": "#f0f0f0",
    "background": "#14141a",
    "border": "#39394a",
    "width": 300,
    "lines": 7,
    "pad": 9,
    "radius": 10
  },

  "note": {
    "font": ["Consolas", 8],
    "color": "#7d7d8c",
    "show": true
  },

  "animations": {
    "idle": {
      "ms": 2600,
      "frames": [
        ["         ", "  \\\\|//  ", " ( o.o ) ", "  |||||  "],
        {"text": ["         ", "  \\\\|//  ", " ( -.- ) ", "  |||||  "],
         "ms": 160}
      ]
    },

    "listening": {
      "ms": 480,
      "color": "#ffe9a8",
      "frames": [
        ["         ", "  \\\\|//  ", " ( o.o ) ", "  |||||  "],
        {"text": ["         ", "  \\\\|//  ", " ( ^.^ ) ", "  |||||  "],
         "dy": -2}
      ]
    },

    "think": {
      "ms": 300,
      "color": "#cfd8ff",
      "frames": [
        ["    .    ", "  \\\\|//  ", " ( -.- ) ", "  |||||  "],
        ["   . .   ", "  \\\\|//  ", " ( -.- ) ", "  |||||  "],
        ["  . . .  ", "  \\\\|//  ", " ( o.o ) ", "  |||||  "],
        ["   . .   ", "  \\\\|//  ", " ( -.- ) ", "  |||||  "]
      ]
    },

    "queued": {
      "ms": 650,
      "color": "#9aa0b4",
      "frames": [
        ["    z    ", "  \\\\|//  ", " ( -.- ) ", "  |||||  "],
        ["   z z   ", "  \\\\|//  ", " ( -.- ) ", "  |||||  "]
      ]
    },

    "work": {
      "fps": 10,
      "color": "#9fe6c4",
      "frames": [
        ["    |    ", "  \\\\|//  ", " ( o.o ) ", "  |||||  "],
        ["    /    ", "  \\\\|//  ", " ( o.o ) ", "  |||||  "],
        ["    -    ", "  \\\\|//  ", " ( o.O ) ", "  |||||  "],
        ["    \\    ", "  \\\\|//  ", " ( o.o ) ", "  |||||  "]
      ]
    },

    "talk": {
      "ms": 170,
      "frames": [
        ["         ", "  \\\\|//  ", " ( o.o ) ", "  |||||  "],
        ["         ", "  \\\\|//  ", " ( oOo ) ", "  |||||  "]
      ]
    },

    "covered": {
      "ms": 220,
      "color": "#d9b3ff",
      "frames": [
        ["    *    ", "  \\\\|//  ", " ( o.o ) ", "  |||||  "],
        ["   * *   ", "  \\\\|//  ", " ( ~.~ ) ", "  |||||  "],
        ["    *    ", "  \\\\|//  ", " ( o.o ) ", "  |||||  "],
        {"text": ["         ", "  \\\\|//  ", " ( o.o ) ", "  |||||  "],
         "ms": 900}
      ]
    },

    "refused": {
      "ms": 120,
      "color": "#ffb3b3",
      "frames": [
        {"text": ["    !    ", "  \\\\|//  ", " ( x.x ) ", "  |||||  "],
         "dx": -4},
        {"text": ["    !    ", "  \\\\|//  ", " ( x.x ) ", "  |||||  "],
         "dx": 4},
        {"text": ["    !    ", "  \\\\|//  ", " ( x.x ) ", "  |||||  "],
         "dx": -2},
        {"text": ["         ", "  \\\\|//  ", " ( o.o ) ", "  |||||  "],
         "ms": 700}
      ]
    },

    "error": {
      "ms": 200,
      "color": "#ff8a8a",
      "frames": [
        ["   !!!   ", "  \\\\|//  ", " ( X_X ) ", "  |||||  "],
        {"text": ["   !!!   ", "  \\\\|//  ", " ( X_X ) ", "  |||||  "],
         "dy": 3},
        {"text": ["         ", "  \\\\|//  ", " ( o.o ) ", "  |||||  "],
         "ms": 1100}
      ]
    },

    "yes": {
      "ms": 150,
      "color": "#9fe6c4",
      "frames": [
        {"text": ["    ^    ", "  \\\\|//  ", " ( ^.^ ) ", "  |||||  "],
         "dy": -4},
        ["    ^    ", "  \\\\|//  ", " ( ^.^ ) ", "  |||||  "],
        {"text": ["    ^    ", "  \\\\|//  ", " ( ^.^ ) ", "  |||||  "],
         "dy": -2},
        {"text": ["         ", "  \\\\|//  ", " ( o.o ) ", "  |||||  "],
         "ms": 800}
      ]
    },

    "no": {
      "ms": 190,
      "color": "#9aa0b4",
      "frames": [
        ["         ", "  \\\\|//  ", " ( -.- ) ", "  |||||  "],
        ["         ", "  \\\\|//  ", " ( o.- ) ", "  |||||  "],
        {"text": ["         ", "  \\\\|//  ", " ( o.o ) ", "  |||||  "],
         "ms": 800}
      ]
    },

    "offline": {
      "ms": 1100,
      "color": "#5c5c6b",
      "frames": [
        ["         ", "  \\\\|//  ", " ( -.- ) ", "  |||||  "],
        ["    z    ", "  \\\\|//  ", " ( -.- ) ", "  |||||  "]
      ]
    },

    "tool:web_search": {
      "fps": 8,
      "color": "#9fd8ff",
      "frames": [
        ["  o->    ", "  \\\\|//  ", " ( o.o ) ", "  |||||  "],
        ["   o->   ", "  \\\\|//  ", " ( o.o ) ", "  |||||  "],
        ["    o->  ", "  \\\\|//  ", " ( o.o ) ", "  |||||  "],
        ["   o->   ", "  \\\\|//  ", " ( o.o ) ", "  |||||  "]
      ]
    }
  },

  "states": {
    "idle": "idle",
    "offline": "offline",
    "listening": "listening",
    "thinking": "think",
    "queued": "queued",
    "tool": "work",
    "speaking": "talk",
    "refused": "refused",
    "covered": "covered",
    "error": "error",
    "confirmed": "yes",
    "cancelled": "no"
  }
}
